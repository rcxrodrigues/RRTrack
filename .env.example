# Postgres (Neon). A string real fica no .env, que nunca vai para o git.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Versão da Graph API usada pelo destino da Meta.
META_GRAPH_VERSION="v21.0"

# Chave de cifragem das credenciais de gateway guardadas no banco.
# Gerar com: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# App da Meta, para o "Entrar com o Facebook" das Integrações.
# Vem de developers.facebook.com -> seu app -> Configurações -> Básico.
# Sem os dois o botão responde 503, e o cadastro manual de token continua valendo.
META_APP_ID=""
META_APP_SECRET=""

# Endereço público desta instalação. É com ele que se monta a URL de retorno do
# login com o Facebook, e ela precisa estar IDÊNTICA na lista de "URIs de
# redirecionamento do OAuth válidos" do app — uma barra de diferença já recusa.
RR_BASE="https://rr-track.vercel.app"
