# Postgres (Neon). A string real fica no .env, que nunca vai para o git.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Versão da Graph API usada pelo destino da Meta.
META_GRAPH_VERSION="v21.0"

# Chave de cifragem das credenciais de gateway guardadas no banco.
# Gerar com: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""
